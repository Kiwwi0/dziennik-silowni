rules_version = '2';
// Dziennik siłowni – każdy folder (osoba) chroniony 4-cyfrowym PIN-em.
// Lista folderów (same imiona) jest widoczna dla wszystkich; plany i treningi tylko dla urządzeń, które podały PIN.
// Reset zapomnianego PIN-u: w konsoli usuń dokument folders/{id}/secret/pin i pole „pin” w folders/{id}.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(fid) { return signedIn() && exists(/databases/$(database)/documents/folders/$(fid)/members/$(request.auth.uid)); }
    function isMemberAfter(fid) { return signedIn() && existsAfter(/databases/$(database)/documents/folders/$(fid)/members/$(request.auth.uid)); }
    function validFolder(d) {
      return d.keys().hasOnly(['name', 'createdAt', 'updatedAt', 'pin'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && (!('pin' in d) || d.pin is bool);
    }
    function validShare(d) {
      return d.keys().hasOnly(['fid', 'from', 'plan', 'custom', 'updatedAt'])
        && d.fid is string && d.from is string && d.from.size() <= 40
        && d.plan is map && d.plan.keys().hasOnly(['name', 'items'])
        && d.plan.name is string && d.plan.name.size() <= 60
        && d.plan.items is list && d.plan.items.size() <= 60
        && d.custom is list && d.custom.size() <= 60
        && d.updatedAt is int;
    }

    // Udostępnione plany: shares/{KOD}. Kto zna kod, może go odczytać (bez listy wszystkich kodów).
    // Utworzyć, zmienić i usunąć może tylko urządzenie z dostępem (PIN) do konta-właściciela.
    match /shares/{code} {
      allow get: if code.matches('^[2-9A-HJKMNP-Z]{6}$');
      allow list: if false;
      allow create: if code.matches('^[2-9A-HJKMNP-Z]{6}$') && validShare(request.resource.data) && isMember(request.resource.data.fid);
      allow update: if validShare(request.resource.data) && request.resource.data.fid == resource.data.fid && isMember(resource.data.fid);
      allow delete: if isMember(resource.data.fid);
    }

    match /folders/{fid} {
      allow read: if true;
      allow create: if signedIn() && validFolder(request.resource.data);
      allow update: if validFolder(request.resource.data) && isMemberAfter(fid);
      allow delete: if isMember(fid);

      // Skrót PIN-u: nikt go nie odczyta; ustawić można tylko raz (zmiana = reset w konsoli).
      match /secret/{doc} {
        allow read, update: if false;
        allow create: if signedIn() && doc == 'pin'
          && existsAfter(/databases/$(database)/documents/folders/$(fid))
          && request.resource.data.keys().hasOnly(['hash'])
          && request.resource.data.hash is string && request.resource.data.hash.size() == 64;
        allow delete: if isMember(fid);
      }

      // Urządzenia z dostępem: wpis powstaje tylko, gdy skrót zgadza się z sekretem.
      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['hash', 'at'])
          && getAfter(/databases/$(database)/documents/folders/$(fid)/secret/pin).data.hash == request.resource.data.hash;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /data/{docId} {
        allow read, write: if docId in ['state', 'diet'] && isMember(fid);
      }
      // Dziennik diety: jeden dokument na dzień (RRRR-MM-DD).
      // Odczyt bez warunku na id dnia: zapytanie o listę dni (ostatnie 60, usuwanie konta) nie zna id z góry,
      // a warunek na id w regule `list` odrzuciłby całe zapytanie.
      match /diet/{day} {
        allow read: if isMember(fid);
        allow write: if isMember(fid) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      match /sessions/{sessionId} {
        allow read, write: if isMember(fid);
      }
    }
  }
}
