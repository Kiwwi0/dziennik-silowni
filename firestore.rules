rules_version = '2';
// Dziennik siłowni – każdy folder (osoba) chroniony 4-cyfrowym PIN-em.
// Lista folderów (same imiona) jest widoczna dla wszystkich; plany i treningi tylko dla urządzeń, które podały PIN.
// Reset zapomnianego PIN-u (tylko konsola Firebase – konsola omija reguły; tryb „set” dla obcych urządzeń nie istnieje):
//  1) policz skrót nowego PIN-u: SHA-256("dziennik-silowni:" + ID_KONTA + ":" + PIN), przepis w komentarzu bloku „PIN folderu” w app.html;
//  2) wpisz go w folders/{id}/secret/pin → pole hash;
//  3) jeśli PIN mógł wyciec – zwiększ o 1 pole gen w folders/{id} (typ number; brak pola = 0, więc wpisz 1) – to wyloguje wszystkie urządzenia;
//  4) jeśli konto jest zablokowane limitem prób – usuń dokument folders/{id}/secret/gate.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function fPath(fid) { return /databases/$(database)/documents/folders/$(fid); }
    function pinPath(fid) { return /databases/$(database)/documents/folders/$(fid)/secret/pin; }
    function gatePath(fid) { return /databases/$(database)/documents/folders/$(fid)/secret/gate; }
    function mPath(fid) { return /databases/$(database)/documents/folders/$(fid)/members/$(request.auth.uid); }
    function tPath(fid) { return /databases/$(database)/documents/folders/$(fid)/tries/$(request.auth.uid); }

    // Członek = własny wpis members z generacją równą generacji konta (brak pola gen = 0, jak w danych sprzed A3).
    // Brak wpisu lub folderu: get() kończy się błędem, a błąd = odmowa. 2 odczyty.
    function isMember(fid) {
      return signedIn() && get(mPath(fid)).data.get('gen', 0) == get(fPath(fid)).data.get('gen', 0);
    }
    function validFolder(d) {
      return d.keys().hasOnly(['name', 'createdAt', 'updatedAt', 'pin', 'gen'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && (!('pin' in d) || d.pin is bool)
        && (!('gen' in d) || (d.gen is int && d.gen >= 0));
    }
    function validHash(d) {
      return d.keys().hasOnly(['hash']) && d.keys().hasAll(['hash'])
        && d.hash is string && d.hash.size() == 64;
    }
    // Żeton: to urządzenie przeszło przez bramkę najwyżej 15 min temu ze skrótem h (odczyt sprzed zapisu – get, nie getAfter).
    function triedPin(fid, h) {
      let t = get(tPath(fid)).data;
      return t.hash == h && t.at > request.time - duration.value(15, 'm');
    }
    // Świeży żeton z poprawnym PIN-em (usuwanie konta).
    function pinFresh(fid) { return triedPin(fid, get(pinPath(fid)).data.hash); }
    // Sekret powstaje albo zmienia się w tym samym zapisie.
    function pinChanging(fid) {
      return !exists(pinPath(fid)) || getAfter(pinPath(fid)).data.hash != get(pinPath(fid)).data.hash;
    }

    // Bramka prób: stałe okna – 15 min (≤ 5 prób) i doba (≤ 10 prób). Czas tylko z request.time.
    // GATE_15 = 5, GATE_DAY = 10 – zmieniać razem ze stałymi o tych nazwach w app.html.
    function gateKeys(n) {
      return n.keys().hasOnly(['n15', 'w15', 'nd', 'wd', 'at']) && n.keys().hasAll(['n15', 'w15', 'nd', 'wd', 'at'])
        && n.at == request.time;
    }
    function gateFirst(n) {
      return gateKeys(n) && n.n15 == 1 && n.w15 == request.time && n.nd == 1 && n.wd == request.time;
    }
    function gateNext(o, n) {
      return gateKeys(n)
        && (request.time > o.w15 + duration.value(15, 'm')
              ? (n.n15 == 1 && n.w15 == request.time)
              : (n.n15 == o.n15 + 1 && n.n15 <= 5 && n.w15 == o.w15))
        && (request.time > o.wd + duration.value(1, 'd')
              ? (n.nd == 1 && n.wd == request.time)
              : (n.nd == o.nd + 1 && n.nd <= 10 && n.wd == o.wd));
    }
    // Zmiana folderu: urządzenie jest członkiem po zapisie; pin nie znika; gen +1 tylko razem ze zmianą istniejącego sekretu.
    function folderUpdOk(fid) {
      let o = resource.data;
      let n = request.resource.data;
      let og = o.get('gen', 0);
      let ng = n.get('gen', 0);
      return getAfter(mPath(fid)).data.get('gen', 0) == ng
        && (n.get('pin', false) == o.get('pin', false) || (n.get('pin', false) == true && existsAfter(pinPath(fid))))
        && (ng == og || (ng == og + 1 && exists(pinPath(fid)) && pinChanging(fid)));
    }
    function validShare(d) {
      return d.keys().hasOnly(['fid', 'from', 'plan', 'custom', 'updatedAt'])
        && d.fid is string && d.from is string && d.from.size() <= 40
        && d.plan is map && d.plan.keys().hasOnly(['name', 'items'])
        && d.plan.name is string && d.plan.name.size() <= 60
        && d.plan.items is list && d.plan.items.size() <= 60
        && d.custom is list && d.custom.size() <= 60
        && d.updatedAt is int;
    }

    // Wspólna baza produktów (skaner kodów): foods/{ean}. Odczyt dla każdego (get, lista ≤ 30), create; update tylko jako awans poprawki (część 2b), bez delete.
    // Dokument nie zawiera informacji, kto dodał produkt.
    // Opcjonalne pola fw/fn (klucz grupy, z której pochodzą obecne wartości/nazwa) i cw/cn (liczba jej głosów) ustawia tylko awans poprawki (część 2b).
    function validFood(d) {
      return d.keys().hasOnly(['n', 'brand', 'u', 'k', 'b', 'w', 't', 'f', 'pg', 'po', 'q', 'src', 'at', 'fw', 'fn', 'cw', 'cn'])
        && d.keys().hasAll(['n', 'brand', 'u', 'k', 'b', 'w', 't', 'f', 'pg', 'po', 'q', 'src', 'at'])
        && (!('fw' in d) || (d.fw is string && d.fw.matches('^w_[0-9a-f]{12}$')))
        && (!('fn' in d) || (d.fn is string && d.fn.matches('^n_[0-9a-f]{12}$')))
        && (!('cw' in d) || (d.cw is int && d.cw >= 1 && d.cw <= 1000))
        && (!('cn' in d) || (d.cn is int && d.cn >= 1 && d.cn <= 1000))
        && d.n is string && d.n.size() > 0 && d.n.size() <= 80
        && d.brand is string && d.brand.size() <= 60
        && d.u in ['g', 'ml']
        && d.k is number && d.k >= 0 && d.k <= 900
        && d.b is number && d.b >= 0 && d.b <= 100
        && d.w is number && d.w >= 0 && d.w <= 100
        && d.t is number && d.t >= 0 && d.t <= 100
        && d.f is number && d.f >= 0 && d.f <= 100
        && d.b + d.w + d.t + d.f <= 105
        && (d.pg == null || (d.pg is number && d.pg > 0 && d.pg <= 5000))
        && d.po is string && d.po.size() <= 40
        && d.q is string && d.q.size() <= 80
        && d.src in ['off', 'user']
        && d.at is int;
    }
    // Poprawki wspólnej bazy (część 2b). FIX_MIN = 3 – zmieniać razem ze stałą FIX_MIN w app.html.
    //  foods/{ean}/fix/{key} – grupa zgłoszeń jednej wersji (w_… wartości, n_… nazwa z marką), tylko liczniki, bez informacji o głosujących.
    //  foods/{ean}/v/{vid}   – głos urządzenia (vid = rodzaj + '_' + uid), czytelny tylko dla właściciela, bez zmian i usuwania.
    // Napisy nie są wycinane (key[0:2]) ani doklejane do ścieżek – rodzaj bierzemy z split('_'), a własny głos składamy w $() z uid.
    function voteNew(ean, key) {
      let v = /databases/$(database)/documents/foods/$(ean)/v/$(key.split('_')[0] + '_' + request.auth.uid);
      return !exists(v) && existsAfter(v) && getAfter(v).data.g == key;
    }
    function numOk(x, hi) { return x is number && x >= 0 && x <= hi; }
    function validFix(key, d) {
      return d.c == 1 && d.at is int
        && (key.matches('^w_.*')
          ? (d.keys().hasOnly(['u', 'k', 'b', 'w', 't', 'f', 'pg', 'po', 'c', 'at'])
            && d.keys().hasAll(['u', 'k', 'b', 'w', 't', 'f', 'pg', 'po', 'c', 'at'])
            && d.u in ['g', 'ml'] && numOk(d.k, 900) && numOk(d.b, 100) && numOk(d.w, 100) && numOk(d.t, 100) && numOk(d.f, 100)
            && d.b + d.w + d.t + d.f <= 105
            && (d.pg == null || (d.pg is number && d.pg > 0 && d.pg <= 5000))
            && d.po is string && d.po.size() <= 40)
          : (d.keys().hasOnly(['n', 'brand', 'c', 'at']) && d.keys().hasAll(['n', 'brand', 'c', 'at'])
            && d.n is string && d.n.size() > 0 && d.n.size() <= 80
            && d.brand is string && d.brand.size() <= 60));
    }
    // Awans: grupa ma ≥ 3 głosy i więcej niż wersja obecna; nowe wartości dokładnie z grupy (getAfter – licznik z tej samej transakcji).
    function promoW(ean) {
      let nw = request.resource.data;
      let g = getAfter(/databases/$(database)/documents/foods/$(ean)/fix/$(nw.fw)).data;
      return nw.diff(resource.data).affectedKeys().hasOnly(['k', 'b', 'w', 't', 'f', 'u', 'pg', 'po', 'fw', 'cw', 'at'])
        && g.c >= 3 && g.c > resource.data.get('cw', 1) && nw.cw == g.c
        && nw.k == g.k && nw.b == g.b && nw.w == g.w && nw.t == g.t && nw.f == g.f && nw.u == g.u && nw.pg == g.pg && nw.po == g.po;
    }
    function promoN(ean) {
      let nw = request.resource.data;
      let g = getAfter(/databases/$(database)/documents/foods/$(ean)/fix/$(nw.fn)).data;
      return nw.diff(resource.data).affectedKeys().hasOnly(['n', 'brand', 'q', 'fn', 'cn', 'at'])
        && g.c >= 3 && g.c > resource.data.get('cn', 1) && nw.cn == g.c
        && nw.n == g.n && nw.brand == g.brand;
    }
    match /foods/{ean} {
      allow get: if ean.matches('^[0-9]{8,14}$');
      allow list: if request.query.limit <= 30;
      allow create: if signedIn() && ean.matches('^[0-9]{8,14}$') && validFood(request.resource.data)
        && !request.resource.data.keys().hasAny(['fw', 'fn', 'cw', 'cn']);
      allow update: if signedIn() && validFood(request.resource.data) && (promoW(ean) || promoN(ean));
      allow delete: if false;

      match /v/{vid} {
        allow get: if signedIn() && (vid == 'w_' + request.auth.uid || vid == 'n_' + request.auth.uid);
        allow list, update, delete: if false;
        allow create: if signedIn() && (vid == 'w_' + request.auth.uid || vid == 'n_' + request.auth.uid)
          && request.resource.data.keys().hasOnly(['g']) && request.resource.data.keys().hasAll(['g'])
          && request.resource.data.g is string
          && request.resource.data.g.matches('^' + vid.split('_')[0] + '_[0-9a-f]{12}$');
      }
      match /fix/{key} {
        allow get: if true;
        allow list: if request.query.limit <= 10;
        allow delete: if false;
        allow create: if signedIn() && ean.matches('^[0-9]{8,14}$') && key.matches('^[wn]_[0-9a-f]{12}$')
          && exists(/databases/$(database)/documents/foods/$(ean)) && validFix(key, request.resource.data) && voteNew(ean, key);
        allow update: if signedIn() && key.matches('^[wn]_[0-9a-f]{12}$')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['c', 'at'])
          && request.resource.data.c == resource.data.c + 1 && request.resource.data.at is int
          && voteNew(ean, key);
      }
    }

    // Udostępnione plany: shares/{KOD}. Kto zna kod, może go odczytać (bez listy wszystkich kodów).
    // Utworzyć, zmienić i usunąć może tylko urządzenie z dostępem (PIN) do konta-właściciela.
    match /shares/{code} {
      allow get: if code.matches('^[2-9A-HJKMNP-Z]{6}$');
      allow list: if false;
      allow create: if code.matches('^[2-9A-HJKMNP-Z]{6}$') && validShare(request.resource.data) && isMember(request.resource.data.fid);
      allow update: if validShare(request.resource.data) && request.resource.data.fid == resource.data.fid && isMember(resource.data.fid);
      allow delete: if isMember(resource.data.fid);
    }

    match /folders/{fid} {
      allow read: if true;
      // Nowe konto: folder + secret/pin + własny wpis members w jednym zapisie grupowym (pinGo, tryb 'new').
      allow create: if signedIn() && validFolder(request.resource.data)
        && request.resource.data.get('pin', false) == true
        && request.resource.data.get('gen', 0) == 0
        && existsAfter(pinPath(fid));
      allow update: if signedIn() && validFolder(request.resource.data) && folderUpdOk(fid);
      // Usunięcie konta: członek ze świeżym żetonem poprawnego PIN-u; sekret znika w tym samym zapisie.
      allow delete: if isMember(fid) && pinFresh(fid) && !existsAfter(pinPath(fid));

      // Skrót PIN-u – nikt go nie odczyta.
      match /secret/pin {
        allow read: if false;
        // Tylko razem z nowym kontem (folder powstaje w tym samym zapisie) albo przez członka konta, które sekretu nie ma.
        allow create: if signedIn() && validHash(request.resource.data)
          && ((!exists(fPath(fid)) && existsAfter(fPath(fid))) || isMember(fid));
        // Zmiana PIN-u: członek, świeży żeton z OBECNYM PIN-em, inny skrót, generacja konta +1 w tym samym zapisie.
        allow update: if isMember(fid) && validHash(request.resource.data)
          && request.resource.data.hash != resource.data.hash
          && triedPin(fid, resource.data.hash)
          && getAfter(fPath(fid)).data.get('gen', 0) == get(fPath(fid)).data.get('gen', 0) + 1;
        // Usunąć można tylko razem z kontem.
        allow delete: if isMember(fid) && !existsAfter(fPath(fid));
      }

      // Bramka prób (bez skrótów). Czytelna, żeby aplikacja pokazała „Spróbuj za … min” i zapisała próbę w transakcji.
      match /secret/gate {
        allow get: if signedIn();
        allow create: if signedIn() && exists(pinPath(fid)) && gateFirst(request.resource.data);
        allow update: if signedIn() && gateNext(resource.data, request.resource.data);
        allow delete: if isMember(fid) && !existsAfter(fPath(fid));
      }

      // Żeton próby: skrót do sprawdzenia; powstaje tylko w tym samym zapisie co zwiększenie bramki.
      match /tries/{uid} {
        allow read: if false;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['hash', 'at']) && request.resource.data.keys().hasAll(['hash', 'at'])
          && request.resource.data.hash is string && request.resource.data.hash.size() == 64
          && request.resource.data.at == request.time
          && getAfter(gatePath(fid)).data.at == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // Urządzenia z dostępem. Wpis = skrót równy sekretowi + generacja równa generacji konta, oraz jedno z:
      //  (a) świeży żeton z tym samym skrótem (logowanie, sprawdzenie PIN-u przed usunięciem/zmianą),
      //  (b) nowe konto – folder powstaje w tym samym zapisie,
      //  (c) członek ustawia lub zmienia PIN w tym samym zapisie (bez tego warunku wpis byłby wyrocznią PIN-u bez limitu).
      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['hash', 'at', 'gen'])
          && request.resource.data.keys().hasAll(['hash', 'at'])
          && request.resource.data.get('gen', 0) == getAfter(fPath(fid)).data.get('gen', 0)
          && request.resource.data.hash == getAfter(pinPath(fid)).data.hash
          && (triedPin(fid, request.resource.data.hash)
            || !exists(fPath(fid))
            || (isMember(fid) && pinChanging(fid)));
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /data/{docId} {
        allow read, write: if docId in ['state', 'diet'] && isMember(fid);
      }
      // Dziennik diety: jeden dokument na dzień (RRRR-MM-DD).
      // Odczyt bez warunku na id dnia: zapytanie o listę dni (ostatnie 60, usuwanie konta) nie zna id z góry,
      // a warunek na id w regule `list` odrzuciłby całe zapytanie.
      match /diet/{day} {
        allow read: if isMember(fid);
        allow write: if isMember(fid) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      match /sessions/{sessionId} {
        allow read, write: if isMember(fid);
      }
    }
  }
}
